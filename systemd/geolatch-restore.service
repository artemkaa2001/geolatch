[Unit]
Description=Restore confirmed GeoLatch firewall from local data
Documentation=https://github.com/artemkaa2001/geolatch
After=local-fs.target nftables.service ufw.service network-online.target
Wants=network-online.target
Before=docker.service
ConditionPathExists=/var/lib/geolatch

[Service]
Type=oneshot
ExecStart=/usr/local/bin/geolatch restore
RemainAfterExit=yes
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/geolatch /var/lib/geolatch /var/cache/geolatch /var/log/geolatch
ReadWritePaths=/etc/systemd/system/geolatch-update.timer.d
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
